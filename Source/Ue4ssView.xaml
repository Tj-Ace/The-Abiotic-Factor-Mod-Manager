<UserControl x:Class="AbioticLoader.Ue4ssView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource ScreenBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="28,14,28,0"
                Background="#C2FBF7"
                BorderBrush="#76D5D0"
                BorderThickness="1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PathRootText"
                                   Foreground="{StaticResource ShellTextBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="&#92;"
                                   Margin="2,0,0,0"
                                   Foreground="#6C8B8F"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="PathLeafText"
                                   Margin="2,0,0,0"
                                   Foreground="{StaticResource ShellTextBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="BackButton"
                            Width="34"
                            Height="28"
                            Margin="0,0,8,0"
                            Background="#EEFDFB"
                            BorderBrush="#8BD9D3"
                            Padding="4" />
                    <Button x:Name="CloseButton"
                            Width="34"
                            Height="28"
                            Background="#FF7F7F"
                            BorderBrush="#D86464"
                            Padding="4" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="28,12,28,14"
                Background="#F8FFFE"
                BorderBrush="#2A7E82"
                BorderThickness="4">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="232" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#EEFDFB"
                            BorderBrush="#9BC7C3"
                            BorderThickness="1">
                <Grid Margin="12,10">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="0,2,0,0">
                                <Image x:Name="Ue4ssLogoImage"
                                       Width="520"
                                       Height="176"
                                       HorizontalAlignment="Center"
                                       Stretch="Uniform"
                                       Margin="0,0,0,0" />
                                <TextBlock x:Name="VersionText"
                                           HorizontalAlignment="Center"
                                           Margin="0,-2,0,0"
                                           Foreground="#121315"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="#111111"
                            BorderBrush="#7A7A7A"
                            BorderThickness="1">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="#000000"
                                    BorderBrush="#4E4E4E"
                                    BorderThickness="1">
                                <Grid Margin="10,6">
                                    <TextBlock x:Name="TerminalHeaderText"
                                               VerticalAlignment="Center"
                                               Foreground="#74FF80"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="UE4SS STATUS TERMINAL" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Margin="0,10,0,0"
                                    Background="#000000"
                                    BorderBrush="#4E4E4E"
                                    BorderThickness="1">
                                <Grid Margin="14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TerminalBundleBuildText"
                                                   Foreground="#74FF80"
                                                   FontSize="31"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Consolas"
                                                   Text="BUNDLE BUILD: 553" />
                                        <TextBlock x:Name="TerminalLatestBuildText"
                                                   Margin="0,10,0,0"
                                                   Foreground="#74FF80"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Consolas"
                                                   Text="NEXUS BUILD: CHECKING..." />
                                        <TextBlock x:Name="TerminalStatusText"
                                                   Margin="0,14,0,0"
                                                   Foreground="#7FFF90"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap"
                                                   Text="STATUS: READY" />
                                    </StackPanel>
                                    <TextBlock x:Name="TerminalSummaryText"
                                               Grid.Row="1"
                                               Margin="0,18,0,0"
                                               Foreground="#8AD7A0"
                                               FontSize="14"
                                               FontFamily="Consolas"
                                               TextWrapping="Wrap"
                                               Text="Open the mod page, patch UE4SS, or update the archive from here." />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#EEFDFB"
                            BorderBrush="#9BC7C3"
                            BorderThickness="1">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Patched In?"
                                       Foreground="#20484E"
                                       FontSize="40"
                                       FontWeight="Normal"
                                       VerticalAlignment="Center" />
                            <Border x:Name="AppliedBox"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    Background="#E7FBFB"
                                    BorderBrush="#20484E"
                                    BorderThickness="2"
                                    VerticalAlignment="Center"
                                    ToolTip="Shows whether UE4SS is already patched into the game folder." />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Up To Date?"
                                       Foreground="#20484E"
                                       FontSize="40"
                                       FontWeight="Normal"
                                       VerticalAlignment="Center" />
                            <Border x:Name="UpToDateBox"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    Background="#E7FBFB"
                                    BorderBrush="#20484E"
                                    BorderThickness="2"
                                    VerticalAlignment="Center"
                                    ToolTip="Shows whether the local UE4SS zip matches the latest release." />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="In Directory?"
                                       Foreground="#20484E"
                                       FontSize="40"
                                       FontWeight="Normal"
                                       VerticalAlignment="Center" />
                            <Border x:Name="InDirectoryBox"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    Background="#E7FBFB"
                                    BorderBrush="#20484E"
                                    BorderThickness="2"
                                    VerticalAlignment="Center"
                                    ToolTip="Shows whether the loader's UE4SS folder contains an archive." />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="#F3FFFD"
                            BorderBrush="#9BC7C3"
                            BorderThickness="1">
                        <UniformGrid Margin="14"
                                     Rows="3"
                                     Columns="2">
                            <Button x:Name="PatchGameButton"
                                    Content="Patch To Game"
                                    Margin="5"
                                    Background="#D9F4FF"
                                    BorderBrush="#6FAFC2"
                                    Foreground="#111111"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    FontFamily="Tahoma"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Padding="14,8"
                                    ToolTip="Copy the newest UE4SS archive from the loader folder into the game install." />
                            <Button x:Name="OpenDirectoryButton"
                                    Content="Open Directory"
                                    Margin="5"
                                    Background="#D9F4FF"
                                    BorderBrush="#6FAFC2"
                                    Foreground="#111111"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    FontFamily="Tahoma"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Padding="14,8"
                                    ToolTip="Open the game's Win64 folder where UE4SS is installed." />
                            <Button x:Name="CheckUpdatesButton"
                                    Content="Check For Updates"
                                    Margin="5"
                                    Background="#D9F4FF"
                                    BorderBrush="#6FAFC2"
                                    Foreground="#111111"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    FontFamily="Tahoma"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Padding="14,8"
                                    ToolTip="Compare the local UE4SS archive against the latest GitHub release." />
                            <Button x:Name="OpenModPageButton"
                                    Content="Open Mod Page"
                                    Margin="5"
                                    Background="#D9F4FF"
                                    BorderBrush="#6FAFC2"
                                    Foreground="#111111"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    FontFamily="Tahoma"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Padding="14,8"
                                    ToolTip="Open the UE4SS GitHub release page." />
                            <Button x:Name="RevertInstallButton"
                                    Content="Revert Install"
                                    Margin="5"
                                    Background="#D9F4FF"
                                    BorderBrush="#6FAFC2"
                                    Foreground="#111111"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    FontFamily="Tahoma"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Padding="14,8"
                                    ToolTip="Remove UE4SS files from the game's Win64 folder." />
                            <Button x:Name="UpdateArchiveButton"
                                    Content="Update UE4SS"
                                    Margin="5"
                                    Background="#D9F4FF"
                                    BorderBrush="#6FAFC2"
                                    Foreground="#111111"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    FontFamily="Tahoma"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Padding="14,8"
                                    ToolTip="Choose a new UE4SS zip to store in the loader's UE4SS folder." />
                        </UniformGrid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="FeedbackPopup"
                Grid.RowSpan="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,92,34,0"
                Width="320"
                Height="150"
                Background="#F7FFFE"
                BorderBrush="#2A7E82"
                BorderThickness="2"
                CornerRadius="2"
                Visibility="Collapsed"
                Panel.ZIndex="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#D6F0ED"
                        BorderBrush="#2A7E82"
                        BorderThickness="0,0,0,1">
                    <TextBlock x:Name="PopupTitleText"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               Foreground="#20484E"
                               FontSize="12"
                               FontWeight="Bold"
                               Text="GATE CHAT // SYSTEM" />
                </Border>
                <TextBlock x:Name="PopupMessageText"
                           Grid.Row="1"
                           Margin="10,8"
                           Foreground="#12383D"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

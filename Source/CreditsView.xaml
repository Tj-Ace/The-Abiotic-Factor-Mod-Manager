<UserControl x:Class="AbioticLoader.CreditsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource ScreenBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="28,14,28,0"
                Background="#C2FBF7"
                BorderBrush="#76D5D0"
                BorderThickness="1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PathRootText"
                               Foreground="{StaticResource ShellTextBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap" />
                    <TextBlock x:Name="PathLeafText"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="InstallStatusText"
                               Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="BackButton"
                            Width="34"
                            Height="28"
                            Margin="0,0,8,0"
                            Background="#EEFDFB"
                            BorderBrush="#8BD9D3"
                            Padding="4" />
                    <Button x:Name="CloseButton"
                            Width="34"
                            Height="28"
                            Background="#FF7F7F"
                            BorderBrush="#D86464"
                            Padding="4" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="28,12,28,14"
                Background="#FFFFFF"
                BorderBrush="#111111"
                BorderThickness="4">
            <Grid Margin="12,10,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                    <TextBlock Text="MOD LOADER : BY TJ &lt;3&#x0a;ABIOTIC FACTOR : BY DEEP FIELD&#x0a;PUBLISHING : BY PLAYSTACK"
                               Foreground="#73E8F1"
                               FontSize="44"
                               FontWeight="SemiBold"
                               FontFamily="Segoe Print, Segoe UI"
                               TextWrapping="Wrap"
                               Margin="4,0,0,4">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="0"
                                              ShadowDepth="2"
                                              Color="#111111"
                                              Opacity="0.95" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="Icons From Flaticon.com"
                               Foreground="#73E8F1"
                               FontSize="24"
                               FontWeight="SemiBold"
                               FontFamily="Segoe Print, Segoe UI"
                               Margin="8,6,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="0"
                                              ShadowDepth="2"
                                              Color="#111111"
                                              Opacity="0.95" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <UniformGrid x:Name="ButtonHost"
                             Grid.Row="2"
                             Columns="5"
                             Margin="0,14,0,0"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Bottom" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

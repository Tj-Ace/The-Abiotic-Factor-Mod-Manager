<UserControl x:Class="AbioticLoader.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource ScreenBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="28,14,28,0"
                Background="#C2FBF7"
                BorderBrush="#76D5D0"
                BorderThickness="1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PathRootText"
                               Foreground="{StaticResource ShellTextBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap" />
                    <TextBlock x:Name="PathLeafText"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="InstallStatusText"
                               Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="BackButton"
                            Width="34"
                            Height="28"
                            Margin="0,0,8,0"
                            Background="#EEFDFB"
                            BorderBrush="#8BD9D3"
                            Padding="4" />
                    <Button x:Name="CloseButton"
                            Width="34"
                            Height="28"
                            Background="#FF7F7F"
                            BorderBrush="#D86464"
                            Padding="4" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,12,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="322" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#FFFFFF"
                    BorderBrush="#111111"
                    BorderThickness="4">
                <Grid Margin="10">
                    <ListBox x:Name="ModList"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="#111111"
                                                    BorderThickness="1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#D7FAF7" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EEFDFB" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="36" Background="#FFFFFF">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding ListStatusIconSource}"
                                           Width="14"
                                           Height="14"
                                           Margin="2,0,6,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowListStatusIcon}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               Foreground="#111111"
                                               FontSize="16"
                                               FontWeight="Normal"
                                               TextAlignment="Left"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#111111"
                    BorderThickness="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="210" />
                    </Grid.RowDefinitions>

                    <Border Background="#FFFFFF"
                            BorderBrush="#111111"
                            BorderThickness="0,0,0,4">
                        <Grid>
                            <TextBlock x:Name="DetailTitle"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#111111"
                                       FontSize="18"
                                       FontWeight="Normal"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="10">
                        <TextBlock x:Name="DetailPath"
                                   Foreground="#111111"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock x:Name="AppliedPathText"
                                   Margin="0,2,0,0"
                                   Foreground="#111111"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock x:Name="PackageKindText"
                                   Margin="0,2,0,0"
                                   Foreground="#111111"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   TextTrimming="CharacterEllipsis" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="DetailSummary"
                                       Foreground="#111111"
                                       FontSize="18"
                                       TextWrapping="Wrap"
                                       TextAlignment="Left" />
                        </ScrollViewer>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="DetailMeta"
                                   Grid.Row="0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,10"
                                   Foreground="#111111"
                                   FontSize="48"
                                   FontWeight="SemiBold"
                                   TextWrapping="NoWrap" />

                        <UniformGrid x:Name="ActionRow"
                                     Grid.Row="1"
                                     Margin="0,0,0,0"
                                     Rows="2"
                                     Columns="3" />
                    </Grid>
                </Grid>
            </Border>

        <Border x:Name="FeedbackPopup"
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,82,38,0"
                Background="#FFFCEB"
                BorderBrush="#111111"
                BorderThickness="2"
                Padding="10"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="FeedbackText"
                           Foreground="#111111"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Width="200" />
            </StackPanel>
        </Border>

            <TextBox x:Name="SearchBox"
                     Visibility="Collapsed" />
            <TextBlock x:Name="SelectedPathText"
                       Visibility="Collapsed" />
            <TextBlock x:Name="CopiedBadge"
                       Visibility="Collapsed" />
            <TextBlock x:Name="StateBadge"
                       Visibility="Collapsed" />
            <TextBlock x:Name="KindBadge"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>

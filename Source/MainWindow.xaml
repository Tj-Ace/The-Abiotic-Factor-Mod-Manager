<Window x:Class="AbioticLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Abiotic Loader"
        Width="1280"
        Height="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="DragBar"
                Grid.Row="0"
                Background="#B8DCE8"
                BorderBrush="#8FC5D6"
                BorderThickness="2"
                Cursor="SizeAll"
                MouseLeftButtonDown="DragBar_MouseLeftButtonDown" />

        <Border Grid.Row="1"
                Background="{StaticResource ShellFrameBrush}"
                Padding="18"
                Margin="0,10,0,0">
            <Border Background="{StaticResource ShellDeepBrush}"
                    Padding="14">
                <Border Background="{StaticResource ScreenBrush}"
                        Padding="0">
                    <ContentControl x:Name="ViewHost" />
                </Border>
            </Border>
        </Border>
    </Grid>
</Window>
